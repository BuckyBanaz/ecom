datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users Model (Customers & Admins)
model User {
  id           String     @id @default(uuid())
  name         String
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  role         String     @default("customer") // customer, admin, superadmin, moderator
  status       String     @default("active") // active, suspended
  permissions  String[]   @default([])
  avatar       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  orders       Order[]
  wishlists    Wishlist[]
  addresses    Address[]
  fcmTokens    String[]   @default([]) @map("fcm_tokens")
  returnRequests ReturnRequest[]
  stockMovements StockMovement[]

  @@map("users")
}

// 2. Groups Model (High-level category collections)
model Group {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("groups")
}

// 2.5. Brands Model
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  logo      String?
  products  Product[]
  series    Series[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

// 2.7. Series Model
model Series {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("series")
}

// 3. Categories Model
model Category {
  id                 String              @id @default(uuid())
  slug               String              @unique
  name               String
  image              String
  group              String // indoor, outdoor, bulbs, business, smart, accessories
  parentId           String?             @map("parent_id")
  parent             Category?           @relation("CategoryParent", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryParent")
  products           Product[]
  seoTitle           String?             @map("seo_title")
  seoDescription     String?             @map("seo_description")
  seoKeywords        String?             @map("seo_keywords")
  sortOrder          Int                 @default(0) @map("sort_order")
  showInNavigation   Boolean             @default(true) @map("show_in_navigation")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("categories")
}

// 3.5. Products Model
model Product {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  name                   String
  brandId                String?                 @map("brand_id")
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId             String                  @map("category_id")
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price                  Float
  oldPrice               Float?                  @map("old_price")
  rating                 Float                   @default(0.0)
  reviewCount            Int                     @default(0) @map("review_count")
  image                  String
  images                 String[]                @default([])
  inStock                Boolean                 @default(true) @map("in_stock")
  isNewArrival           Boolean                 @default(false) @map("is_new_arrival")
  isBestSelling          Boolean                 @default(false) @map("is_best_selling")
  description            String
  shortDescription       String                  @default("") @map("short_description")
  specs                  Json                    @default("{}")
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  reviews                Review[]
  wishlists              Wishlist[]
  productAttributeValues ProductAttributeValue[]
  variants               ProductVariant[]

  @@map("products")
}

// 4. Attributes Model
model Attribute {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  type                   String // select, multi_select, range, boolean
  visibility             String                  @default("both") // admin, filter, both
  attributeValues        AttributeValue[]
  productAttributeValues ProductAttributeValue[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("attributes")
}

// 4.5. Attribute Values Model
model AttributeValue {
  id                     String                  @id @default(uuid())
  attributeId            String                  @map("attribute_id")
  attribute              Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value                  String
  colorCode              String?                 @map("color_code") // for hex codes of colors
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues VariantAttributeValue[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("attribute_values")
}

// 5.5. Product Attribute Values Mapping Model
model ProductAttributeValue {
  id               String         @id @default(uuid())
  productId        String         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId      String         @map("attribute_id")
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValueId String         @map("attribute_value_id")
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([productId, attributeId, attributeValueId])
  @@map("product_attribute_values")
}

// 6. Product Variants Model
model ProductVariant {
  id                     String                  @id @default(uuid())
  productId              String                  @map("product_id")
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String                  @unique
  stock                  Int                     @default(0)
  price                  Float?                  // overrides product price if set
  variantAttributeValues VariantAttributeValue[]
  inventoryItems         InventoryItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockTransfers         StockTransfer[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("product_variants")
}

// 6.5. Variant Attribute Values Mapping Model
model VariantAttributeValue {
  id               String         @id @default(uuid())
  variantId        String         @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String         @map("attribute_value_id")
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

// 4. Reviews Model
model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  title     String
  text      String
  images    String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

// 5. Orders Model
model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  subtotal        Float
  shipping        Float
  total           Float
  status          String      @default("pending")
  paymentMethod   String      @map("payment_method")
  paymentStatus   String      @default("pending") @map("payment_status")
  stripeSessionId String?     @map("stripe_session_id")
  stripePaymentId String?     @map("stripe_payment_id")
  shippingAddress String      @map("shipping_address")
  // Sendcloud / Tracking
  trackingNumber  String?     @map("tracking_number")
  trackingUrl     String?     @map("tracking_url")
  labelUrl        String?     @map("label_url")
  carrier         String?
  shippingCost    Float?      @map("shipping_cost")
  shipmentStatus  String?     @map("shipment_status")
  deliveredAt     DateTime?   @map("delivered_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]
  returnRequests  ReturnRequest[]

  @@map("orders")
}

// 6. Order Items Model
model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String? @map("product_id")
  productName  String  @map("product_name")
  productImage String  @map("product_image")
  quantity     Int
  price        Float
  variant      String?

  @@map("order_items")
}

// 7. Wishlists Model
model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlists")
}

// 7.5. Blogs Model
model Blog {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String   @default("")
  body           String   @default("")
  cover          String?
  author         String   @default("")
  published      Boolean  @default(true)
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String?  @map("seo_keywords")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("blogs")
}

// 8. CMS Configuration Model
model CmsConfig {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_config")
}

// 13. Address Model
model Address {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // e.g. "Home", "Work"
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String
  street      String
  houseNumber String?  @map("house_number") // Required for Sendcloud shipments
  landmark    String?
  city        String
  state       String
  pincode     String
  country     String
  lat         String?
  lng         String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

// 9. Mega Menu Model
model MegaMenu {
  id        String   @id @default(uuid())
  menu      String
  slug      String   @unique
  sections         Json     @default("[]") // Array of sections and items
  isFoldedMobile   Boolean  @default(false) @map("is_folded_mobile")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("mega_menus")
}

// 10. CMS Pages Model
model CmsPage {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  body        String   @default("")
  published   Boolean  @default(false)
  seoTitle    String?  @map("seo_title")
  seoDesc     String?  @map("seo_desc")
  seoKeywords String?  @map("seo_keywords")
  seoImage    String?  @map("seo_image")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

// 11. Email Templates Model
model EmailTemplate {
  id           String   @id @default(uuid())
  name         String   @unique
  subject      String
  body         String
  smsBody      String?  @map("sms_body")
  whatsappBody String?  @map("whatsapp_body")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// 14. Coupons & Offers Model
model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // "percentage" | "flat"
  value         Float
  minOrderValue Float    @default(0.0) @map("min_order_value")
  isActive      Boolean  @default(true) @map("is_active")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("coupons")
}

// 15. Store Charges (Shipping, GST, Taxes) Model
model StoreCharge {
  id         String   @id @default(uuid())
  name       String   @unique // e.g. "Shipping", "GST"
  type       String   // "percentage" | "flat"
  value      Float
  isActive   Boolean  @default(true) @map("is_active")
  minFreeLimit Float  @default(0.0) @map("min_free_limit")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("store_charges")
}

// 16. AI Product Drafts (Quick Add — save before publish)
model ProductDraft {
  id        String   @id @default(uuid())
  status    String   @default("draft") // draft | published | failed
  batchId   String?  @map("batch_id")
  name      String?
  payload   Json
  error     String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([batchId])
  @@map("product_drafts")
}

// 17. Return Requests (customer returns + AI triage)
model ReturnRequest {
  id               String    @id @default(uuid())
  orderId          String    @map("order_id")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           String?   @map("user_id")
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason           String
  customerNote     String?   @map("customer_note")
  photos           Json      @default("[]")
  status           String    @default("pending_review") // pending_review | approved | awaiting_return | return_received | refunded | rejected | cancelled
  aiFraudScore     Float?    @map("ai_fraud_score")
  aiSummary        String?   @map("ai_summary")
  aiRecommendation String?   @map("ai_recommendation") // auto_approve | needs_review | likely_fraud
  adminNote        String?   @map("admin_note")
  refundAmount     Float?    @map("refund_amount")
  stripeRefundId   String?   @map("stripe_refund_id")
  refundProcessedAt DateTime? @map("refund_processed_at")
  refundExpectedAt DateTime? @map("refund_expected_at")
  returnCarrier          String?   @map("return_carrier")
  returnTrackingNumber   String?   @map("return_tracking_number")
  returnTrackingUrl      String?   @map("return_tracking_url")
  returnLabelUrl         String?   @map("return_label_url")
  returnShipMethodId     String?   @map("return_ship_method_id")
  returnParcelId         String?   @map("return_parcel_id")
  returnShipmentStatus   String?   @map("return_shipment_status")
  itemReceivedAt         DateTime? @map("item_received_at")
  reviewedAt             DateTime? @map("reviewed_at")
  resolutionType         String?   @map("resolution_type") // refund | replacement
  resolutionNote         String?   @map("resolution_note")
  replacementOrderId     String?   @map("replacement_order_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// =========================================================================
// 18. DUAL-LAYER INVENTORY & WAREHOUSE MODULE
// =========================================================================

enum WarehouseType {
  CENTRAL_WAREHOUSE
  RETAIL_STORE
  THIRD_PARTY_LOGISTICS
  DROPSHIPPER
}

enum StockMovementType {
  PURCHASE_ORDER_RECEIPT   // Stock received from supplier into storage
  WEBSHOP_ALLOCATION_INC   // Quota moved from storage reserve to webshop
  WEBSHOP_ALLOCATION_DEC   // Quota removed from webshop back to storage
  ORDER_RESERVATION        // Locked during checkout
  ORDER_RESERVATION_CANCEL // Released on cart abort / payment fail
  ORDER_FULFILLED          // Permanently deducted upon dispatch
  MANUAL_STORAGE_ADJUST    // Physical storage cycle count correction
  RETURN_RESTOCK           // Restocked from customer return
  DAMAGED_SCRAP            // Written off due to damage
  TRANSFER_OUT             // Shipped to another warehouse
  TRANSFER_IN              // Received from another warehouse
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// 18.1. Warehouses / Storage Locations
model Warehouse {
  id           String            @id @default(uuid())
  code         String            @unique // e.g., "WH-MAIN", "STORE-AMS"
  name         String
  type         WarehouseType     @default(CENTRAL_WAREHOUSE)
  contactName  String?           @map("contact_name")
  email        String?
  phone        String?
  addressLine1 String            @map("address_line1")
  addressLine2 String?           @map("address_line2")
  city         String
  postalCode   String            @map("postal_code")
  country      String            @default("NL")
  isDefault    Boolean           @default(false) @map("is_default")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]
  transfersFrom  StockTransfer[] @relation("TransferSource")
  transfersTo    StockTransfer[] @relation("TransferDestination")

  @@map("warehouses")
}

// 18.2. Dual-Layer Inventory Levels per Variant & Warehouse
model InventoryItem {
  id                  String          @id @default(uuid())
  warehouseId         String          @map("warehouse_id")
  warehouse           Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId           String          @map("variant_id")
  variant             ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  // Storage (Physical) Stock Metrics
  quantityOnHand      Int             @default(0) @map("quantity_on_hand")     // Total in physical storage
  quantityDamaged     Int             @default(0) @map("quantity_damaged")     // Damaged / quarantined
  binLocation         String?         @map("bin_location")                    // Shelf / Rack e.g. "A-04-2"
  
  // Webshop Channel Metrics
  isPublishedWebshop  Boolean         @default(true) @map("is_published_webshop") // Whether item is on webshop
  webshopAllocated    Int             @default(0) @map("webshop_allocated")    // Max stock allocated to webshop
  quantityReserved    Int             @default(0) @map("quantity_reserved")    // In-checkout locks
  
  // Reorder & Procurement Alerts
  reorderPoint        Int             @default(10) @map("reorder_point")       // Storage low alert threshold
  reorderQuantity     Int             @default(50) @map("reorder_quantity")    // Default PO replenishment qty
  
  // Barcode & QR Identification
  customBarcode       String?         @unique @map("custom_barcode")          // EAN / UPC / Custom barcode
  qrCodePayload       String?         @map("qr_code_payload")                 // Raw payload / Deep-link
  
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  movements           StockMovement[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([customBarcode])
  @@map("inventory_items")
}

// 18.3. Immutable Stock Movement Ledger (Audit Log)
model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String            @map("inventory_item_id")
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            StockMovementType
  
  quantityChange  Int               @map("quantity_change") // Positive or negative delta
  previousOnHand  Int               @map("previous_on_hand")
  newOnHand       Int               @map("new_on_hand")
  
  previousWebshop Int?              @map("previous_webshop")
  newWebshop      Int?              @map("new_webshop")
  
  referenceType   String?           @map("reference_type")  // "ORDER", "PURCHASE_ORDER", "RETURN", "QR_SCAN", "MANUAL"
  referenceId     String?           @map("reference_id")    // order_id, po_id, etc.
  reason          String?                                   // "Cycle count correction", "Transferred to webshop", etc.
  
  performedBy     String?           @map("performed_by")    // Admin user ID or "SYSTEM"
  performedByUser User?             @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([inventoryItemId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

// 18.4. Suppliers / Vendors
model Supplier {
  id             String          @id @default(uuid())
  name           String          @unique
  code           String?         @unique // e.g. "SUP-MUTLU-01"
  contactPerson  String?         @map("contact_person")
  email          String?
  phone          String?
  address        String?
  leadTimeDays   Int             @default(7) @map("lead_time_days")
  currency       String          @default("EUR")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// 18.5. Purchase Orders (PO) for Procurement
model PurchaseOrder {
  id             String              @id @default(uuid())
  poNumber       String              @unique @map("po_number") // e.g. "PO-2026-001"
  supplierId     String              @map("supplier_id")
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId    String              @map("warehouse_id")
  status         POStatus            @default(DRAFT)
  totalAmount    Float               @default(0.0) @map("total_amount")
  currency       String              @default("EUR")
  expectedDate   DateTime?           @map("expected_date")
  receivedDate   DateTime?           @map("received_date")
  notes          String?
  createdBy      String?             @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  items          PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

// 18.6. Purchase Order Items (Line Items)
model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String        @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  orderedQuantity  Int           @map("ordered_quantity")
  receivedQuantity Int           @default(0) @map("received_quantity")
  unitCost         Float         @map("unit_cost")
  subtotal         Float

  @@map("purchase_order_items")
}

// 18.7. Inter-Warehouse Transfers
model StockTransfer {
  id                  String     @id @default(uuid())
  transferNumber      String     @unique @map("transfer_number")
  sourceWarehouseId   String     @map("source_warehouse_id")
  sourceWarehouse     Warehouse  @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouseId   String     @map("target_warehouse_id")
  targetWarehouse     Warehouse  @relation("TransferDestination", fields: [targetWarehouseId], references: [id])
  
  variantId           String     @map("variant_id")
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  quantity            Int
  status              String     @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, CANCELLED
  trackingRef         String?    @map("tracking_ref")
  notes               String?
  initiatedBy         String?    @map("initiated_by")
  
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("stock_transfers")
}
