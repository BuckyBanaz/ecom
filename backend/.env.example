# Application Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database Connection (PostgreSQL)
# For local Postgres, replace username, password, host, port, and database name
# Windows: use 127.0.0.1 not localhost (IPv6 ::1 can fail with Docker)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ecom_db?schema=public"

# Security Configuration
JWT_SECRET="super-secret-ecom-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Redis Cache Config
REDIS_URL="redis://localhost:6379"

# Optional: Google Analytics Data API + Search Console (admin dashboards)
# GA4_PROPERTY_ID=
# GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY=
# GSC_SITE_URL=https://yoursite.com/
# ANALYTICS_GA4=G-XXXXXXXX
# ANALYTICS_GTM=GTM-XXXXXXX

# General store settings (also editable in Admin → Settings → General)
# STORE_NAME=Schip & Ster
# STORE_URL=https://schipenster.com
# SUPPORT_EMAIL=support@schipenster.com
# API_DOCS_ENABLED=true
# INVOICE_VENDOR_NAME=Schip & Ster BV
# INVOICE_VENDOR_ADDRESS=Keizersgracht 456, Amsterdam
# INVOICE_VENDOR_EMAIL=billing@schipenster.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
