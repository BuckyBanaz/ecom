{
  email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Cross-Origin-Opener-Policy "same-origin"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  handle /robots.txt {
    reverse_proxy backend:5000
  }
  handle /sitemap.xml {
    reverse_proxy backend:5000
  }
  handle /llms.txt {
    reverse_proxy backend:5000
  }
  handle /uploads/* {
    reverse_proxy backend:5000
  }

  @staticFiles {
    path *.ico *.png *.jpg *.jpeg *.gif *.svg *.css *.js *.webmanifest *.json *.woff *.woff2 *.txt *.xml
  }
  handle @staticFiles {
    reverse_proxy frontend:80
  }

  @bots {
    header_regexp User-Agent (?i)(googlebot|bingbot|facebookexternalhit|twitterbot|linkedinbot|slackbot|whatsapp|yandexbot|discordbot|baiduspider)
    not path_regexp (?i)\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|json|woff2?|xml|webmanifest|txt)$
  }
  handle @bots {
    rewrite * /seo-proxy{uri}
    reverse_proxy backend:5000
  }

  handle {
    reverse_proxy frontend:80
  }
}

api.{$DOMAIN} {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Cross-Origin-Opener-Policy "same-origin"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy backend:5000
}
